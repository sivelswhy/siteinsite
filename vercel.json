{
	"framework": null,
	"buildCommand": "node scripts/copy-assets.js",
	"outputDirectory": "public",
	"rewrites": [
		{
			"source": "/wisp/",
			"destination": "/api/wisp"
		},
		{
			"source": "/wisp",
			"destination": "/api/wisp"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Cross-Origin-Opener-Policy",
					"value": "same-origin"
				},
				{
					"key": "Cross-Origin-Embedder-Policy",
					"value": "require-corp"
				}
			]
		},
		{
			"source": "/sw.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache"
				}
			]
		}
	]
}
